{
  "name": "wellnesscafe-os",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "type": "module",
  "scripts": {
    "test:client-practitioner-journey": "npm --prefix functions run test:client-practitioner-journey",
    "test:practitioner-registry": "npm --prefix functions run test:practitioner-registry",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --exclude src/security/firestore.rules.test.js",
    "test:rules": "FIREBASE_EMULATORS_PATH=/tmp/wellnesscafe-firebase-emulators npx --yes firebase-tools@15.31.0 emulators:exec --only firestore --project demo-wellnesscafe-rules \"vitest run src/security/firestore.rules.test.js\"",
    "verify:release": "export npm_config_cache=/tmp/wellnesscafe-npm-cache XDG_CONFIG_HOME=/tmp/wellnesscafe-firebase-config FIREBASE_CLI_DISABLE_UPDATE_CHECK=1; npm test -- --maxWorkers=1 && npm --prefix functions run test:agent-contracts && npm --prefix functions run test:client-agent-workflows && npm run test:client-practitioner-journey && npm run test:practitioner-care && npm run test:provider-scheduling && npm run test:practitioner-messaging && npm run test:workspace-lifecycle && npm run test:help-directory && npm run test:recovery-sources && npm run test:food-directory && npm run test:rules && npm run build && npm run predeploy:check && git diff --check",
    "test:agent-controls": "npm --prefix functions run test:agent-controls",
    "test:admin-observability": "npm --prefix functions run test:admin-observability",
    "test:practitioner-care": "npm --prefix functions run test:practitioner-care",
    "test:practitioner-messaging": "npm --prefix functions run test:practitioner-messaging",
    "test:provider-scheduling": "npm --prefix functions run test:provider-scheduling",
    "test:admin-user-access": "npm --prefix functions run test:admin-user-access",
    "test:account-access": "npm --prefix functions run test:account-access",
    "test:workspace-lifecycle": "npm --prefix functions run test:workspace-lifecycle",
    "smoke:agents:production": "node scripts/smoke-agents-production.mjs --smoke-env-file=.env.production.smoke",
    "test:recovery-sources": "npm --prefix functions run test:recovery-sources",
    "test:help-directory": "npm --prefix functions run test:help-directory",
    "test:food-directory": "npm --prefix functions run test:food-directory",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy:check": "node scripts/check-deploy.js",
    "steward:build": "node scripts/build_steward_context.mjs",
    "pod:verify": "node scripts/pod/verify_pod_context.mjs",
    "deploy": "npm run predeploy:check && npm_config_cache=/tmp/wellnesscafe-npm-cache FIREBASE_CLI_DISABLE_UPDATE_CHECK=1 npx --yes firebase-tools@15.31.0 deploy --only hosting --project wellnesscafelanding",
    "grant:admin": "node scripts/grantAdmin.cjs",
    "grant:admin:aleggi": "node scripts/grantAdmin.cjs aleggi007@gmail.com",
    "emu:doctor": "node scripts/emu.doctor.mjs",
    "emu:clean": "node scripts/emu.clean.mjs",
    "emu:start": "firebase emulators:start --only functions,firestore,auth",
    "emu:start:clean": "node scripts/emu.clean.mjs && firebase emulators:start --only functions,firestore,auth",
    "current:phase": "node scripts/currentPhase.generate.mjs",
    "repo:audit": "sh scripts/repo-audit.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.5",
    "framer-motion": "^12.23.26",
    "livekit-client": "^2.22.3",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
