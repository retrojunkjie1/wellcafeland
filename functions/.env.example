# Firebase Functions - Environment Variables
# Copy to .env and fill in values. Never commit .env.

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# RapidAPI (for globalResourceSearch)
# Production uses Firebase Secret Manager (firebase functions:secrets:set RAPIDAPI_KEY)
# Local emulator: set here when Secret Manager fetch fails
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=real-time-web-search.p.rapidapi.com

# CORS allowlist (comma-separated). Required in production.
# Example: ALLOWED_ORIGINS=https://wellnesscafe.net,https://wellnesscafelanding.web.app
# In dev/emulator, localhost origins (5173, 5174, 5180, 5182, 3000) are always allowed.
ALLOWED_ORIGINS=
