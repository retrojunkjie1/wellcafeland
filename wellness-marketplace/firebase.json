{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "functions": { "source": "functions" },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": { "port": 8082 },
    "hosting": { "port": 5002 },
    "ui": { "port": 4002 },
    "hub": { "port": 4402 },
    "logging": { "port": 4502 }
  }
}
