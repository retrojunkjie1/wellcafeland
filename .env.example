# WellnessCafe OS - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=wellnesscafe-os.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wellnesscafe-os
VITE_FIREBASE_STORAGE_BUCKET=wellnesscafe-os.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Multimodal Wellness Engine Configuration
VITE_OPENAI_HAS_AUDIO=true

# Firebase Functions URL — leave blank for DEV (uses emulator via hostname:5001)
# For production: VITE_FIREBASE_FUNCTIONS_URL=https://us-central1-YOUR-PROJECT.cloudfunctions.net
VITE_FIREBASE_FUNCTIONS_URL=

# Resource search credentials belong on the server, never in VITE_* variables.
# For local Functions emulators, configure functions/.env (see functions/.env.example).
# Production uses Firebase Secret Manager for RAPIDAPI_KEY.
