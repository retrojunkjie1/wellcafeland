rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin access via header
    function isAdmin() {
      return request.headers['x-admin-secret'] == resource.data.adminSecret || 
             request.auth != null && request.auth.token.admin == true;
    }
    
    // Users collection: anonymous users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.resource.data.userId == userId || isAdmin();
    }
    
    // Sessions collection: users can create, but only read their own (admin can read all)
    match /sessions/{sessionId} {
      allow create: if true; // Anyone can create
      allow read: if resource.data.userId == request.resource.data.userId || isAdmin();
      allow update, delete: if resource.data.userId == request.resource.data.userId || isAdmin();
    }
    
    // Telemetry collection: anyone can create, only admin can read
    match /telemetry/{telemetryId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // Memory collection: users can create, but only read their own (admin can read all)
    match /memory/{memoryId} {
      allow create: if true;
      allow read: if resource.data.userId == request.resource.data.userId || isAdmin();
      allow update, delete: if resource.data.userId == request.resource.data.userId || isAdmin();
    }
    
    // Session templates: public read, admin write
    match /sessionTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admin users collection: only admins can read/write
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }
    
    // Admin configuration: only admins can read/write
    match /admin/{doc} {
      allow read, write: if isAdmin();
    }
    
    // Default: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

